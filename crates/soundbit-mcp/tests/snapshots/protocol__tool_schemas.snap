[
  {
    "annotations": null,
    "description": "Clears one or more bars of a track.",
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "bars": {
          "description": "Explicit bars, counted from 0.",
          "items": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "count": {
          "description": "Number of consecutive bars starting at `start_bar`. Defaults to 1.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "start_bar": {
          "description": "First bar of a run of consecutive bars.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "track_id": {
          "description": "Track to clear.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "track_id"
      ],
      "type": "object"
    },
    "name": "arrangement_clear"
  },
  {
    "annotations": null,
    "description": "Places a pattern on a track at one or more bars, replacing what was there. Example: start_bar 0, count 8 repeats it for eight bars.",
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "bars": {
          "description": "Explicit bars, counted from 0, e.g. [0, 2, 4].",
          "items": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "count": {
          "description": "Number of consecutive bars starting at `start_bar`. Defaults to 1.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "pattern_id": {
          "description": "Pattern to place.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "start_bar": {
          "description": "First bar of a run of consecutive bars.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "track_id": {
          "description": "Track to place on.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "track_id",
        "pattern_id"
      ],
      "type": "object"
    },
    "name": "arrangement_place"
  },
  {
    "annotations": null,
    "description": "Places many patterns at once, e.g. a whole arrangement, as one undo step. Each placement is like arrangement_place. If any placement is invalid, nothing changes. Returns the arrangement grid.",
    "input_schema": {
      "$defs": {
        "PlacementInput": {
          "description": "One pattern placement inside `arrangement_place_many`. Give either `bars` or `start_bar`\n(+ `count`).",
          "properties": {
            "bars": {
              "description": "Explicit bars, counted from 0.",
              "items": {
                "format": "uint16",
                "maximum": 65535,
                "minimum": 0,
                "type": "integer"
              },
              "type": [
                "array",
                "null"
              ]
            },
            "count": {
              "description": "Number of consecutive bars starting at `start_bar`. Defaults to 1.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "pattern_id": {
              "description": "Pattern to place.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "start_bar": {
              "description": "First bar of a run of consecutive bars.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "track_id": {
              "description": "Track to place on.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "track_id",
            "pattern_id"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "placements": {
          "description": "The placements, at most 512. Later ones replace earlier ones in the same bar.",
          "items": {
            "$ref": "#/$defs/PlacementInput"
          },
          "type": "array"
        }
      },
      "required": [
        "placements"
      ],
      "type": "object"
    },
    "name": "arrangement_place_many"
  },
  {
    "annotations": null,
    "description": "Renders the song to a 16-bit stereo WAV file in the workspace so the user can listen to it. Rendering is deterministic. Reports the peak and RMS level of the mix and of every track, so you can balance the mix without hearing it.",
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "path": {
          "description": "Path relative to the workspace, e.g. `renders/theme.wav`.",
          "type": "string"
        },
        "sample_rate": {
          "description": "Sample rate in hertz, 8000-192000. Defaults to 48000.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "name": "export_wav"
  },
  {
    "annotations": {
      "readOnlyHint": true
    },
    "description": "Lists SoundBit project files (.sbproj) in the workspace.",
    "input_schema": {
      "properties": {},
      "type": "object"
    },
    "name": "files_list"
  },
  {
    "annotations": null,
    "description": "Redoes the most recently undone change and returns what was redone.",
    "input_schema": {
      "properties": {},
      "type": "object"
    },
    "name": "history_redo"
  },
  {
    "annotations": null,
    "description": "Undoes the most recent change (yours or the user's) and returns what was undone.",
    "input_schema": {
      "properties": {},
      "type": "object"
    },
    "name": "history_undo"
  },
  {
    "annotations": null,
    "description": "Adds an instrument: a voice (pulse, triangle, sawtooth, sine, noise, wavetable or fm) with envelope, optional sound shaping (pitch envelope, vibrato, unison, filter), volume, pan and reverb send. Returns its id. See reference_get for voice parameters; instrument_add_preset is quicker for common sounds.",
    "input_schema": {
      "$defs": {
        "DutyCycle": {
          "enum": [
            "eighth",
            "quarter",
            "half",
            "three_quarters"
          ],
          "type": "string"
        },
        "EnvelopeInput": {
          "description": "Envelope settings. Unset values keep the current (or default) value.",
          "properties": {
            "attack_ms": {
              "description": "Attack time in milliseconds, 0-10000.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "decay_ms": {
              "description": "Decay time in milliseconds, 0-10000.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "release_ms": {
              "description": "Release time in milliseconds, 0-10000.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "sustain_percent": {
              "description": "Sustain level in percent, 0-100.",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "type": "object"
        },
        "FilterInput": {
          "description": "A resonant filter on every note. A low-pass softens bright waves (saw, pulse) into strings,\npads and basses; an envelope depth makes the tone open as each note starts.",
          "properties": {
            "cutoff_hz": {
              "description": "Cutoff frequency in hertz, 20-20000.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "envelope_semitones": {
              "description": "How far the amplitude envelope moves the cutoff, in semitones at full level, -72 to 72.",
              "format": "int8",
              "maximum": 127,
              "minimum": -128,
              "type": [
                "integer",
                "null"
              ]
            },
            "mode": {
              "anyOf": [
                {
                  "$ref": "#/$defs/FilterMode"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter type; \"off\" bypasses the filter."
            },
            "resonance_percent": {
              "description": "Emphasis around the cutoff in percent, 0-100; above 70 it whistles.",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "type": "object"
        },
        "FilterMode": {
          "enum": [
            "off",
            "low_pass",
            "high_pass",
            "band_pass"
          ],
          "type": "string"
        },
        "FmOperatorInput": {
          "description": "One FM operator. Unset values keep the defaults (full level, instant attack, no decay).",
          "properties": {
            "attack_rate": {
              "description": "Attack rate 0-31; 31 is instant.",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "decay_rate": {
              "description": "First decay rate 0-31.",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "detune": {
              "description": "Fine detune -3 to 3.",
              "format": "int8",
              "maximum": 127,
              "minimum": -128,
              "type": [
                "integer",
                "null"
              ]
            },
            "multiple": {
              "description": "Frequency multiplier 0-15 (0 means x0.5).",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "release_rate": {
              "description": "Release rate 0-15.",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "sustain_level": {
              "description": "Level where the first decay ends, 0-15 (0 is loudest).",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "sustain_rate": {
              "description": "Second decay rate while held, 0-31.",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "total_level": {
              "description": "Attenuation 0-127; 0 is loudest. Modulators set brightness with this.",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "type": "object"
        },
        "NoiseMode": {
          "enum": [
            "long",
            "short"
          ],
          "type": "string"
        },
        "PitchEnvelopeInput": {
          "description": "A pitch glide at the start of every note: the note starts `semitones` away and slides to\nits own pitch over `time_ms`. Use it for kicks and toms (+24 to +36 over 40-120 ms),\ntimpani (+3 to +7), lasers and risers.",
          "properties": {
            "semitones": {
              "description": "Start offset in semitones, -48 to 48; positive values fall into the note. 0 turns the\nglide off.",
              "format": "int8",
              "maximum": 127,
              "minimum": -128,
              "type": [
                "integer",
                "null"
              ]
            },
            "time_ms": {
              "description": "Glide time in milliseconds, 0-10000.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "type": "object"
        },
        "UnisonInput": {
          "description": "Several detuned copies of the voice playing together: turns a thin wave into an ensemble\n(strings, choirs, supersaws). Noise voices ignore it.",
          "properties": {
            "detune_cents": {
              "description": "Detune of the outermost copies in cents either side, 0-50; 8-20 is lush, 25+ is wide.",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "voices": {
              "description": "Number of copies, 1-4. 1 turns unison off.",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "type": "object"
        },
        "VibratoInput": {
          "description": "A periodic pitch wobble for held notes (strings, flutes, leads).",
          "properties": {
            "delay_ms": {
              "description": "Milliseconds before the vibrato starts, 0-10000; 150-300 sounds like a real player.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "depth_cents": {
              "description": "Depth in cents either side of the note, 0-100; 10-25 sounds natural. 0 turns vibrato\noff.",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "rate_hz": {
              "description": "Speed in hertz, 0.1-20.0; 5-6 sounds natural.",
              "format": "float",
              "type": [
                "number",
                "null"
              ]
            }
          },
          "type": "object"
        },
        "VoiceInput": {
          "description": "The sound source of an instrument.",
          "oneOf": [
            {
              "description": "Pulse (square) wave, the NES and Game Boy lead sound.",
              "properties": {
                "duty": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/DutyCycle"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Width of the high part of the wave. Defaults to \"half\"."
                },
                "type": {
                  "const": "pulse",
                  "type": "string"
                }
              },
              "required": [
                "type"
              ],
              "type": "object"
            },
            {
              "description": "NES-style stepped triangle wave, typical for basslines.",
              "properties": {
                "type": {
                  "const": "triangle",
                  "type": "string"
                }
              },
              "required": [
                "type"
              ],
              "type": "object"
            },
            {
              "description": "Bright sawtooth wave.",
              "properties": {
                "type": {
                  "const": "sawtooth",
                  "type": "string"
                }
              },
              "required": [
                "type"
              ],
              "type": "object"
            },
            {
              "description": "Pure sine wave.",
              "properties": {
                "type": {
                  "const": "sine",
                  "type": "string"
                }
              },
              "required": [
                "type"
              ],
              "type": "object"
            },
            {
              "description": "Noise for drums. Higher notes sound brighter.",
              "properties": {
                "mode": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/NoiseMode"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "\"long\" for hiss, \"short\" for metallic noise. Defaults to \"long\"."
                },
                "type": {
                  "const": "noise",
                  "type": "string"
                }
              },
              "required": [
                "type"
              ],
              "type": "object"
            },
            {
              "description": "Custom single-cycle waveform, like the Game Boy wave channel.",
              "properties": {
                "samples": {
                  "description": "Exactly 32 levels, each 0-15.",
                  "items": {
                    "format": "uint8",
                    "maximum": 255,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "type": "array"
                },
                "type": {
                  "const": "wavetable",
                  "type": "string"
                }
              },
              "required": [
                "type",
                "samples"
              ],
              "type": "object"
            },
            {
              "description": "Four-operator FM, like the Sega Genesis. Unset values use a plain sine patch.",
              "properties": {
                "algorithm": {
                  "description": "Operator routing 0-7.",
                  "format": "uint8",
                  "maximum": 255,
                  "minimum": 0,
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "feedback": {
                  "description": "Operator 1 self-feedback 0-7.",
                  "format": "uint8",
                  "maximum": 255,
                  "minimum": 0,
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "operators": {
                  "description": "Up to four operators; missing ones are silent.",
                  "items": {
                    "$ref": "#/$defs/FmOperatorInput"
                  },
                  "type": "array"
                },
                "type": {
                  "const": "fm",
                  "type": "string"
                }
              },
              "required": [
                "type"
              ],
              "type": "object"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "envelope": {
          "$ref": "#/$defs/EnvelopeInput",
          "description": "Amplitude envelope. New instruments default to a short, plucky envelope."
        },
        "filter": {
          "$ref": "#/$defs/FilterInput",
          "description": "Resonant filter."
        },
        "name": {
          "description": "Display name, e.g. \"Lead\" or \"Kick\".",
          "type": "string"
        },
        "pan": {
          "description": "Stereo position, -100 (left) to 100 (right).",
          "format": "int8",
          "maximum": 127,
          "minimum": -128,
          "type": [
            "integer",
            "null"
          ]
        },
        "pitch_envelope": {
          "$ref": "#/$defs/PitchEnvelopeInput",
          "description": "Pitch glide at the start of each note."
        },
        "reverb_send_percent": {
          "description": "Share sent to the song's reverb in percent, 0-100; 20-50 places an instrument in a\nroom, 0 keeps it dry (kicks and basses usually stay dry).",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "unison": {
          "$ref": "#/$defs/UnisonInput",
          "description": "Detuned copies of the voice."
        },
        "vibrato": {
          "$ref": "#/$defs/VibratoInput",
          "description": "Pitch wobble for held notes."
        },
        "voice": {
          "$ref": "#/$defs/VoiceInput",
          "description": "Sound source."
        },
        "volume": {
          "description": "Volume in percent, 0-100.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "voice"
      ],
      "type": "object"
    },
    "name": "instrument_add"
  },
  {
    "annotations": null,
    "description": "Adds a ready-made instrument from the preset library (strings, brass, choir, timpani, drums, chip leads, FM keys...). Returns its id and full settings, which instrument_update can tweak. List presets with preset_list.",
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "name": {
          "description": "Display name; defaults to the preset's name.",
          "type": [
            "string",
            "null"
          ]
        },
        "preset": {
          "description": "Preset id from `preset_list`, e.g. `strings_ensemble` or `kick`.",
          "type": "string"
        }
      },
      "required": [
        "preset"
      ],
      "type": "object"
    },
    "name": "instrument_add_preset"
  },
  {
    "annotations": {
      "destructiveHint": true
    },
    "description": "Removes an instrument. Fails while a pattern still uses it; change or remove those patterns first.",
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "id": {
          "description": "Instrument id.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "name": "instrument_remove"
  },
  {
    "annotations": null,
    "description": "Changes an instrument's name, voice, envelope, sound shaping, volume, pan or reverb send. Only the given fields change, also inside groups such as vibrato or filter.",
    "input_schema": {
      "$defs": {
        "DutyCycle": {
          "enum": [
            "eighth",
            "quarter",
            "half",
            "three_quarters"
          ],
          "type": "string"
        },
        "EnvelopeInput": {
          "description": "Envelope settings. Unset values keep the current (or default) value.",
          "properties": {
            "attack_ms": {
              "description": "Attack time in milliseconds, 0-10000.",
