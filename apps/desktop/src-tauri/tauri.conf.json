{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SoundBit",
  "version": "0.1.0",
  "identifier": "dev.soundbit.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SoundBit",
        "width": 1320,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Renas Demirbas",
    "copyright": "Copyright (C) 2026 Renas Demirbas. GPL-3.0-or-later.",
    "category": "Music",
    "shortDescription": "Chiptune workstation for humans and AI agents",
    "longDescription": "SoundBit is a tracker-style editor for 8-bit and 16-bit music with a built-in MCP server, so AI agents can compose, edit and render songs in the same session you are editing.",
    "homepage": "https://github.com/RenasDemirbas/SoundBit",
    "license": "GPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
